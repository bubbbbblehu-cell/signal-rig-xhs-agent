{
  "name": "signal-rig-xhs-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Offline Signal Rig photo installation for Xiaohongshu MiniTool",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173 --directory dist",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "pack": "npm run build && npm run check && python3 scripts/package.py",
    "dev": "vite",
    "test": "node scripts/test-save.mjs && node scripts/test-photo-slots.mjs"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "vite": "^6.4.1"
  }
}
